/* =========================================================================
   DIGITAL SOUK - UI TOOLKIT THEME & STYLESHEET
   Cyber-Bazaar High-Fidelity UI Theme for Unity 6
   ========================================================================= */

/* --- ROOT CONTAINER --- */
.screen-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    -unity-font-definition: initial;
    color: #f1f5f9;
}

/* --- FULLSCREEN OVERLAYS --- */
.overlay-backdrop {
    width: 100%;
    height: 100%;
    position: absolute;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 10, 18, 0.82);
    transition: opacity 0.25s ease-out;
}

.overlay-backdrop--start-menu {
    background-color: rgba(4, 7, 14, 0.75);
}

.overlay-backdrop--pause-menu {
    background-color: rgba(5, 9, 17, 0.85);
}

.overlay-hidden {
    display: none;
    opacity: 0;
}

/* --- HUD OVERLAY --- */
.hud-overlay {
    position: absolute;
    top: 24px;
    right: 28px;
    padding: 8px 16px;
    background-color: rgba(15, 23, 42, 0.65);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(56, 189, 248, 0.2);
    flex-direction: row;
    align-items: center;
}

.hud-hint-key {
    background-color: rgba(56, 189, 248, 0.15);
    border-color: #38bdf8;
    border-width: 1px;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    -unity-font-style: bold;
    color: #38bdf8;
    margin-right: 8px;
}

.hud-hint-text {
    font-size: 13px;
    color: #cbd5e1;
}

/* --- MAIN DIALOG / PANEL CARDS --- */
.menu-card {
    width: 480px;
    max-width: 90%;
    background-color: rgba(15, 23, 42, 0.94);
    border-radius: 16px;
    border-width: 1.5px;
    border-color: rgba(56, 189, 248, 0.35);
    padding: 36px 40px;
    align-items: center;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
}

.menu-card--pause {
    border-color: rgba(245, 158, 11, 0.35);
}

/* --- BRANDING & HEADERS --- */
.brand-badge {
    padding: 4px 12px;
    background-color: rgba(56, 189, 248, 0.12);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 12px;
    text-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
}

.brand-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 3px;
    text-shadow: 0 4px 14px rgba(0, 0, 0, 0.8);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.brand-subtitle {
    font-size: 13px;
    color: #94a3b8;
    letter-spacing: 2px;
    margin-bottom: 28px;
    -unity-text-align: middle-center;
}

.menu-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-bottom: 24px;
}

/* --- BUTTON CONTAINER --- */
.button-stack {
    width: 100%;
    flex-direction: column;
}

/* --- BUTTONS --- */
.menu-btn {
    width: 100%;
    height: 50px;
    margin-bottom: 12px;
    background-color: rgba(30, 41, 59, 0.8);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.2);
    color: #e2e8f0;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    transition: background-color 0.15s ease-out, border-color 0.15s ease-out, scale 0.15s ease-out;
}

.menu-btn:hover,
.menu-btn:focus {
    background-color: rgba(51, 65, 85, 0.95);
    border-color: #38bdf8;
    color: #ffffff;
    scale: 1.02;
}

.menu-btn:active {
    background-color: rgba(15, 23, 42, 0.95);
    scale: 0.98;
}

/* Primary Button (Play / Resume) */
.menu-btn--primary {
    background-color: rgba(14, 116, 144, 0.75);
    border-color: #06b6d4;
    color: #ffffff;
}

.menu-btn--primary:hover,
.menu-btn--primary:focus {
    background-color: #0891b2;
    border-color: #67e8f9;
    scale: 1.03;
}

/* Accent Button (Resume in Pause Menu) */
.menu-btn--accent {
    background-color: rgba(180, 83, 9, 0.8);
    border-color: #f59e0b;
    color: #ffffff;
}

.menu-btn--accent:hover,
.menu-btn--accent:focus {
    background-color: #d97706;
    border-color: #fde68a;
    scale: 1.03;
}

/* Danger / Quit Button */
.menu-btn--danger:hover,
.menu-btn--danger:focus {
    background-color: rgba(153, 27, 27, 0.7);
    border-color: #f87171;
    color: #fecaca;
}

/* Modal Back Button */
.menu-btn--back {
    margin-top: 16px;
    background-color: rgba(30, 41, 59, 0.6);
    border-color: rgba(148, 163, 184, 0.3);
}

.menu-btn--back:hover,
.menu-btn--back:focus {
    background-color: rgba(51, 65, 85, 0.95);
    border-color: #38bdf8;
    color: #ffffff;
    scale: 1.02;
}

/* --- SETTINGS & FORM CONTROLS --- */
.settings-group {
    width: 100%;
    margin-bottom: 20px;
}

.settings-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: #cbd5e1;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
}

.settings-slider {
    width: 100%;
    margin: 4px 0;
}

.settings-slider .unity-base-slider__dragger {
    background-color: #38bdf8;
    border-radius: 50%;
    width: 16px;
    height: 16px;
    border-width: 0;
.settings-slider:focus .unity-base-slider__dragger {
    background-color: #67e8f9;
    scale: 1.35;
    border-width: 2px;
    border-color: #ffffff;
}

.settings-slider:focus .unity-base-slider__tracker {
    background-color: rgba(56, 189, 248, 0.4);
}

.settings-toggle {
    margin: 6px 0;
    color: #e2e8f0;
    font-size: 14px;
    padding: 6px 8px;
    border-radius: 6px;
    border-width: 1px;
    border-color: transparent;
    transition: border-color 0.15s ease-out, background-color 0.15s ease-out;
}

.settings-toggle:focus {
    background-color: rgba(51, 65, 85, 0.7);
    border-color: #38bdf8;
    color: #ffffff;
}

.settings-toggle .unity-toggle__checkmark {
    border-radius: 4px;
    background-color: #1e293b;
    border-color: #475569;
}

.settings-toggle:checked .unity-toggle__checkmark {
    background-color: #38bdf8;
    border-color: #38bdf8;
}

/* --- CONTROLS GUIDE CARD --- */
.controls-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    margin-bottom: 6px;
    background-color: rgba(30, 41, 59, 0.5);
    border-radius: 8px;
}

.controls-key {
    background-color: rgba(56, 189, 248, 0.15);
    border-color: rgba(56, 189, 248, 0.4);
    border-width: 1px;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    -unity-font-style: bold;
    color: #38bdf8;
}

.controls-desc {
    font-size: 13px;
    color: #f1f5f9;
}

/* --- FOOTER INFO --- */
.version-text {
    font-size: 11px;
    color: #64748b;
    margin-top: 14px;
    -unity-text-align: middle-center;
}
